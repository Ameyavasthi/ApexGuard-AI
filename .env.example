# ═══════════════════════════════════════════════════════════════════
#  ApexGuard-AI  —  Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your actual values.
#  NEVER commit the real .env file — it is in .gitignore.
# ═══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8005

# ── Camera Source ─────────────────────────────────────────────────
# Options: "webcam" | "ip_camera"
ACTIVE_CAMERA=webcam
WEBCAM_SOURCE=0

# IP Camera — only used when ACTIVE_CAMERA=ip_camera
# Format: http://<ip>:<port>/video  OR  rtsp://<user>:<pass>@<ip>/stream
IP_CAMERA_SOURCE=http://192.168.1.100:8080/video

# ── Detection Thresholds (0.0 – 1.0) ─────────────────────────────
ANIMAL_CONFIDENCE_THRESHOLD=0.50
FIRE_CONFIDENCE_THRESHOLD=0.50
WEAPON_CONFIDENCE_THRESHOLD=0.40

# ── Alert Cooldown ────────────────────────────────────────────────
# Seconds between repeated alerts for the same threat type
ALERT_COOLDOWN_SECONDS=30

# ── Video Recording ───────────────────────────────────────────────
CLIP_DURATION_SECONDS=8
CAMERA_FPS=20
PRE_EVENT_BUFFER_FRAMES=40
